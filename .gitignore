# ---- OS clutter ----
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Editors ----
.vscode/
.idea/
*.swp
*~

# ---- Rise / Articulate source and export archives ----
# Keep the UNZIPPED course folder under courses/ — never the zip.
# Zips are large, unservable by Pages, and bloat git history permanently.
*.zip
*.rar
*.7z
*.story
*.rise

# ---- Working files that shouldn't ship ----
# Drafts, storyboards, scripts, raw media, anything staged but not published.
drafts/
_working/
*.psd
*.ai
*.indd
*.mp4
*.mov
*.avi
*.wav
*.aep

# ---- Credentials and config, never commit ----
.env
.env.*
*.pem
*.key
secrets*

# ---- Local server / tooling noise ----
node_modules/
.cache/
*.log
